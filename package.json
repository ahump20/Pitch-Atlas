{
  "name": "pitch-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A living museum and conversation space for the heritage, history, craft, and evolving art of pitching.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && PITCH_ATLAS_CHECK_DIST=1 vitest run src/test/prerender-integrity.test.ts",
    "build:island-learning": "node scripts/build-island-learning.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "fetch:tweet": "node scripts/fetch-tweet.mjs",
    "design-sync": "node scripts/design-sync.mjs",
    "design-sync:check": "node scripts/design-sync.mjs --check",
    "test": "vitest run --reporter dot && node --test .design-sync/artifact/*.node-test.mjs",
    "test:preview:browser": "node scripts/preview-browser-smoke.mjs",
    "test:watch": "vitest",
    "test:archive:browser": "node scripts/archive-browser-acceptance.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/supabase-js": "^2.118.0",
    "@unhead/react": "^3.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "mediabunny": "1.62.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.4",
    "react-tweet": "^3.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "25.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "shadcn": "^4.22.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-react-ssg": "^0.2.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "undici": "^7.28.0"
  }
}
